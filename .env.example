# Copie para .env e preencha. O .env NUNCA é versionado (ver .gitignore).

# ---------------------------------------------------------------------------
# Backend de LLM: azure | openai | vllm | stub
# ---------------------------------------------------------------------------
WRAG_LLM_BACKEND=azure

AZURE_OPENAI_API_KEY=
# Use UMA das duas. BASE_URL é usada exatamente como está — é o que gateway
# corporativo costuma exigir. ENDPOINT faz o SDK montar
# /openai/deployments/<modelo>/... em cima dela.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Nome do DEPLOYMENT no recurso, não o nome oficial do modelo.
WRAG_AZURE_DEPLOYMENT=gpt-5-mini

# Se a rede fizer inspeção TLS, aponte para o PEM da CA raiz corporativa.
# Sem ele a conexão nem chega ao Azure, e o erro de SSL não se parece com um
# problema de API.
AZURE_OPENAI_CA_BUNDLE=

# Modelos de reasoning (gpt-5, o1, o3, o4) gastam parte do teto pensando ANTES
# de escrever. Teto baixo devolve content="" com finish_reason="length".
# Se `diag-azure` devolver vazio sem bloqueio, suba para 12000.
WRAG_AZURE_REASONING_MIN_TOKENS=8000
WRAG_AZURE_REASONING_EFFORT=minimal
WRAG_AZURE_MAX_TOKENS=2048
WRAG_AZURE_CONCURRENCY=8
WRAG_AZURE_MAX_RETRIES=6

# ---------------------------------------------------------------------------
# Filtro de conteúdo
# ---------------------------------------------------------------------------
# Bloqueio é resultado, não exceção: o item é registrado e o lote continua.
WRAG_CONTINUE_ON_CONTENT_FILTER=1
# Acima desta taxa (depois de 50 chamadas) a rodada aborta: um filtro que recusa
# 1 em 4 significa que o prompt ou o corpus está batendo sistematicamente na
# política, e o benchmark resultante não seria interpretável.
WRAG_MAX_FILTER_RATE=0.25

# ---------------------------------------------------------------------------
# Embeddings: auto | azure | st | tfidf
# ---------------------------------------------------------------------------
WRAG_EMBED_BACKEND=auto
# Se o gateway tiver deployment de embedding, defina aqui e ele será preferido.
WRAG_AZURE_EMBED_DEPLOYMENT=
# Fallback local (exige sentence-transformers + GPU).
WRAG_EMBED_MODEL=BAAI/bge-large-en-v1.5
WRAG_EMBED_DEVICE=cuda
WRAG_EMBED_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Escopo da rodada
# ---------------------------------------------------------------------------
WRAG_SEED=42
WRAG_N_QUESTIONS=100
WRAG_TOP_K=5
WRAG_DATASETS=musique,2wikimultihopqa,hotpotqa
WRAG_METHODS=dense,graphrag,hipporag,hipporag2,witnessrag
WRAG_LOG_LEVEL=INFO
